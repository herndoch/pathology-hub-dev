# Copy to .env and fill in values (never commit .env — it is gitignored).
# In Cursor Cloud, add these same names as project secrets instead; they inject as env vars.

GOOGLE_CLOUD_PROJECT=pathology-annotation-project
PATHOLOGY_HUB_API_BASE=https://pathology-hub-v04-vorn5q2kga-uc.a.run.app

# Required for /evidence/search against live or local backend
PATHOLOGY_HUB_API_KEY=

# Required for local backend vector search (query embeddings)
OPENAI_API_KEY=

# GCS access — pick ONE approach:
# A) Path to a service-account JSON file on disk:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# B) Paste the full JSON as one line (dev.sh writes it to /tmp/gcp-adc.json automatically):
# GCP_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
