{
  "schema_version": "evidence_query_expansion_rules.v0_2_1",
  "description": "Governed abbreviation and synonym expansion for evidence search. C/AR/F are never map_status. v0_2.1: added allow_standalone for single-allowed-root abbreviations proven safe in diagnostics; added WHO 5th-edition NOS/NST title-boost alias.",
  "rules": [
    {
      "abbreviation": "LCIS",
      "expansions": [
        "lobular carcinoma in situ"
      ],
      "allowed_roots": [
        "Breast"
      ],
      "required_context_terms": [
        "breast",
        "lobular",
        "mammary"
      ],
      "blocked_roots": [],
      "ambiguity_risk": "medium",
      "expansion_mode": "append_query",
      "allow_standalone": true,
      "enabled": true,
      "notes": "Breast in-situ lesion; standalone expansion allowed (high pathology specificity)."
    },
    {
      "abbreviation": "SSL",
      "expansions": [
        "sessile serrated lesion",
