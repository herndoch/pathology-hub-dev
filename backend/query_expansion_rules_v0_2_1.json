      "blocked_roots": [
        "Cyto_Soft_Tissue"
      ],
      "ambiguity_risk": "high",
      "expansion_mode": "append_query",
      "enabled": true,
      "notes": "Block secure-sockets-layer false positives in textbook cyto/informatics chunks. [v0_2_1: allow_standalone enabled -- single allowed_root, proven safe against BST/GI/GYN/Skin cross-root regression set in miss diagnostics 2026-07-05.]",
      "allow_standalone": true
    },
